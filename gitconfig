# Personal/public git config, safe to include from any machine's ~/.gitconfig.
# Machine- or employer-specific overrides (identity, hooksPath, includeIf blocks,
# etc.) belong in ~/.gitconfig itself, placed AFTER the [include] that pulls this
# file in, so they take precedence.
#
# To wire this up on a new laptop:
#   1. Clone/symlink this dotfiles repo (see _make_symlinks.sh)
#   2. Add to the top of ~/.gitconfig:
#        [include]
#          path = ~/tree/dotfiles/gitconfig
#   3. Set user.email in ~/.gitconfig itself (not here, since this file is public)

[user]
	name = Edmund Yan
[core]
	excludesfile = ~/.gitignore
	editor = vim
[rerere]
  enabled = 1
[remote "origin"]
  push = HEAD
[branch "master"]
  merge = refs/heads/master
[alias]
  br = branch
  ci = commit -a
  co = checkout
  cp = cherry-pick
  dwc = diff -w -M --color-words
  fix = rebase -i origin/master
  new = !sh -c 'git log $1@{1}..$1@{0} "$@"'
  recent-branches = --paginate for-each-ref --format='%(committerdate:relative)%09%(refname:short)' --sort='-committerdate' refs/heads
  recent-branches-origin = --paginate for-each-ref --format='%(committerdate:relative)%09%(refname:short)' --sort='-committerdate' refs/remotes/origin
  re = remote -v
  st = status
  sup = "submodule foreach 'git co master; git up'"
  tree = log --graph --decorate --pretty=oneline --abbrev-commit --all
  up = "!git remote update -p; git merge --ff-only @{u}"
  everything = log --pretty=format: --name-only --diff-filter=A
  browse = "!hub browse"
  pf = push --force-with-lease
  staged = diff --staged
[push]
  default = simple
[merge]
  defaultToUpstream = true
[color]
  ui = true
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = osxkeychain
[url "ssh://git@github.com"]
	insteadOf = https://github.com
# use separate file for username / github token / etc
[include]
  path = ~/.gitconfig.local
